# companion-engine environment configuration
# Copy this file to `.env` (in your data root) and fill in real values.
#
# SECURITY WARNING: values stored in `.env` are written and read as PLAINTEXT.
# Any process (or Electron extension/renderer) with filesystem or process.env
# access can read them. For production, prefer OS keychain encryption via
# electron.safeStorage (see `protectSecret` in src/config.ts) instead of
# persisting sensitive values in `.env`.

# --- AI provider ---
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-20250514
AI_API_KEY=
# AI_BASE_URL=
# AI_MAX_TOKENS=2048
# AI_TEMPERATURE=0.85

# --- Backup AI provider (optional) ---
# AI_BACKUP_PROVIDER=anthropic
# AI_BACKUP_MODEL=
# AI_BACKUP_API_KEY=
# AI_BACKUP_BASE_URL=

# --- QQ (optional) ---
# QQ_WS_URL=ws://127.0.0.1:3001
# QQ_ACCESS_TOKEN=

# --- WeChat (optional) ---
# WECHAT_BASE_URL=
# WECHAT_FILE_URL=
# WECHAT_TOKEN=
# WECHAT_APPID=

# --- Safety / behaviour ---
# CONTENT_FILTER=strict
# TOPIC_SELF_CHECK=false
