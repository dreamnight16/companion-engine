{
  "name": "@sixtdreamnight/companion-engine",
  "version": "0.5.0",
  "description": "AI companion core engine — personality, relationship, memory, safety, pipeline, streaming, emotion model, semantic search",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist/"
  ],
  "peerDependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "ai": "^6.0.0",
    "dotenv": "^17.0.0",
    "node-cron": "^3.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "GPL-3.0",
  "author": "DreamNight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamnight16/companion-engine.git"
  },
  "bugs": {
    "url": "https://github.com/dreamnight16/companion-engine/issues"
  },
  "homepage": "https://github.com/dreamnight16/companion-engine#readme",
  "keywords": [
    "ai",
    "companion",
    "chatbot",
    "llm",
    "personality",
    "relationship",
    "memory",
    "emotion",
    "safety",
    "typescript"
  ]
}
